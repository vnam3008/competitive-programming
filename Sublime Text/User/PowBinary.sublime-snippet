	<content><![CDATA[
long long Pow(long long a, long long b, long long MOD = 1e9 + 7){
    long long ans = 1;
    while (b){
        if (b & 1) ans = (MOD > 0 ? 1LL * ans * a % MOD : 1LL * ans * a);
        a = (MOD > 0 : 1ll * a * a % MOD : 1LL * a * a);
        b >>= 1;
    }
    return ans;
}
]]></content>
